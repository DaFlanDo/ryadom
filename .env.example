# ── Ryadom · переменные окружения ──
# Скопируй в .env.local и подставь реальные значения.
# .env / .env.local в git не попадают (см. .gitignore).

# Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase → Settings → API → service_role secret
# СЕКРЕТ! Только на сервере, без префикса NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Подпись сессионной cookie. Любая длинная случайная строка.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Адрес сайта для абсолютных ссылок в превью (og:image). На Vercel можно не задавать.
# NEXT_PUBLIC_SITE_URL=https://ryadom.app

# «Попробовать без регистрации» (/try): каждому посетителю своя копия демо-страницы
# на сутки. Включено по умолчанию; 0 — выключить
# DEMO_SANDBOX=0
